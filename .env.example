# Supabase → Connect:
#  - DATABASE_URL: "Transaction pooler" (puerto 6543) + ?pgbouncer=true&connection_limit=1  ← la usa la app (Vercel)
#  - DIRECT_URL:   "Session pooler" (puerto 5432)                                        ← la usan las migraciones
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Mínimo 32 caracteres. Firma las sesiones y cifra las claves privadas de ARCA.
# Si lo cambiás, los certificados guardados dejan de poder descifrarse.
APP_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32+"
